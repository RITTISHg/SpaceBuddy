# Copy to .env (never commit .env). Real environment variables override this file.
NASA_API_KEY=            # free key from https://api.nasa.gov/  (alias NASA_OPEN_API also accepted)
GEMINI_API_KEY=          # optional: enables AI Cosmo; leave empty to use the built-in topic answers
GEMINI_MODEL=gemini-2.0-flash   # check the current model name in Google's docs
CORS_ORIGIN=*            # set to your frontend URL in production, e.g. https://your-app.vercel.app
PORT=8787
